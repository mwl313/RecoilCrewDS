[Unit]
Description=Recoil Crew authoritative game server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/recoilcrew/current
EnvironmentFile=/etc/recoilcrew.env
EnvironmentFile=-/opt/recoilcrew/current/.release-env
ExecStart=/usr/local/bin/node dist-server/index.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
