{
  "name": "recoil-crew",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recoil Crew - two-player online cooperative tank game",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "server": "node dist-server/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:demo": "tsx scripts/demo-regression.ts",
    "demo:write": "tsx scripts/demo-regression.ts --write",
    "test:maps": "vitest run tests/mapgen.test.ts && tsx scripts/mapgen-report.ts",
    "test:maps:sweep": "tsx scripts/mapgen-sweep.ts",
    "generate:map-profiles": "tsx scripts/generate-map-profile-bundle.ts",
    "dev:maplab": "vite --config tools/maplab/vite.config.ts",
    "build:maplab": "npm run generate:map-profiles && vite build --config tools/maplab/vite.config.ts",
    "test:maplab": "vitest run tests/maplab",
    "maplab:apply": "tsx scripts/apply-maplab-profile.ts",
    "maplab:apply-server": "tsx scripts/maplab-apply-server.ts",
    "test:e2e": "playwright test",
    "test:loop": "node scripts/verify-full-round.mjs",
    "start": "npm run build && npm run server"
  },
  "dependencies": {
    "three": "^0.178.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^24.0.0",
    "@types/three": "^0.178.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "tweakpane": "^4.0.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
