{
  "id": "scene.createCrew",
  "label": "Create Crew",
  "type": "ui",
  "enterTransition": { "type": "fade", "durationMs": 140 },
  "root": {
    "id": "screen-create",
    "type": "container",
    "class": "screen ui-screen form-screen",
    "children": [
      { "id": "create-frame", "type": "container", "class": "ui-safe-frame" },
      { "id": "create-topbar", "type": "horizontal", "class": "ui-topbar", "children": [
        { "id": "create-unit", "type": "text", "class": "ui-unit-mark", "text": "RC / CREW LINK" },
        { "id": "create-step", "type": "text", "class": "ui-system-state", "text": "HOST CHANNEL" }
      ] },
      {
        "id": "create-panel",
        "type": "panel",
        "class": "ui-form-panel",
        "appearance": { "tone": "neutral", "emphasis": "standard", "density": "comfortable", "shape": "plate" },
        "children": [
          { "id": "create-kicker", "type": "text", "class": "ui-kicker", "text": "CREW LINK // HOST" },
          { "id": "create-title", "type": "text", "props": { "tag": "h2" }, "text": "CREATE CREW" },
          { "id": "create-copy", "type": "text", "class": "ui-form-copy", "text": "Send this code to your Gunner. The run begins when both crew members lock in." },
          {
            "id": "create-codebox",
            "type": "horizontal",
            "class": "ui-code-box",
            "children": [
              { "id": "create-code", "type": "text", "class": "code", "bindings": [{ "target": "text", "source": "code", "fallback": "------" }] },
              { "id": "copy-code", "type": "button", "class": "ui-compact-action", "text": "COPY", "bindings": [{ "target": "text", "source": "copyLabel", "fallback": "COPY" }], "actions": [{ "event": "click", "action": "app.copyRoomCode" }] }
            ]
          },
          { "id": "create-status", "type": "text", "class": "ui-status-line", "text": "WAITING FOR GUNNER…", "bindings": [{ "target": "text", "source": "status", "fallback": "WAITING FOR GUNNER…" }] },
          { "id": "create-ready", "type": "button", "class": "ui-action", "appearance": { "tone": "action", "emphasis": "hero", "density": "comfortable", "shape": "plate" }, "text": "READY", "actions": [{ "event": "click", "action": "app.ready" }] },
          { "id": "create-back", "type": "button", "class": "ui-text-action", "props": { "dataAct": "back" }, "text": "BACK", "actions": [{ "event": "click", "action": "app.back" }] }
        ]
      },
      { "id": "create-footer", "type": "text", "class": "ui-screen-footer", "text": "PRIVATE ROOM // TWO CREW MAX" }
    ]
  },
  "previewStates": [
    { "id": "waiting", "label": "Waiting", "context": { "code": "AB12CD", "status": "WAITING FOR GUNNER…", "copyLabel": "COPY" } },
    { "id": "copied", "label": "Copied", "context": { "code": "AB12CD", "status": "WAITING FOR GUNNER…", "copyLabel": "COPIED" } }
  ]
}
