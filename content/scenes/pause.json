{
  "id": "scene.pause",
  "label": "Pause",
  "type": "ui",
  "enterTransition": {
    "type": "fade",
    "durationMs": 180
  },
  "exitTransition": {
    "type": "fade",
    "durationMs": 140
  },
  "root": {
    "id": "screen-pause",
    "type": "container",
    "class": "screen ui-overlay-screen pause-screen",
    "children": [
      {
        "id": "pause-scrim",
        "type": "container",
        "class": "ui-overlay-scrim pause-scrim"
      },
      {
        "id": "pause-frame",
        "type": "container",
        "class": "ui-safe-frame"
      },
      {
        "id": "pause-topbar",
        "type": "horizontal",
        "class": "ui-topbar pause-topbar",
        "children": [
          {
            "id": "pause-unit",
            "type": "text",
            "class": "ui-unit-mark",
            "text": "RC / FIELD UNIT 07"
          },
          {
            "id": "pause-state",
            "type": "text",
            "class": "ui-system-state pause-system-state",
            "text": "SIMULATION HOLD",
            "textKey": "ui.pause.state"
          }
        ]
      },
      {
        "id": "pause-panel",
        "type": "panel",
        "class": "ui-overlay-panel pause-panel",
        "children": [
          {
            "id": "pause-kicker",
            "type": "text",
            "class": "ui-kicker",
            "text": "FIELD CONTROL // LOCAL",
            "textKey": "ui.pause.kicker"
          },
          {
            "id": "pause-title",
            "type": "text",
            "props": {
              "tag": "h2"
            },
            "text": "PAUSED",
            "textKey": "ui.pause.title"
          },
          {
            "id": "pause-rule",
            "type": "container",
            "class": "ui-overlay-rule"
          },
          {
            "id": "pause-copy",
            "type": "text",
            "class": "pause-copy",
            "text": "Shared chassis is holding position. Resume when the crew is ready.",
            "textKey": "ui.pause.help"
          },
          {
            "id": "pause-actions",
            "type": "vertical",
            "class": "pause-actions",
            "children": [
              {
                "id": "resume-btn",
                "type": "button",
                "class": "ui-action",
                "appearance": {
                  "tone": "action",
                  "emphasis": "hero",
                  "density": "comfortable",
                  "shape": "plate"
                },
                "text": "RESUME",
                "actions": [
                  {
                    "event": "click",
                    "action": "app.resume"
                  }
                ],
                "textKey": "ui.pause.resume"
              },
              {
                "id": "pause-single",
                "type": "button",
                "class": "ui-action",
                "appearance": {
                  "tone": "neutral",
                  "emphasis": "standard",
                  "density": "comfortable",
                  "shape": "plate"
                },
                "props": {
                  "dataAct": "single"
                },
                "text": "RESTART MATCH",
                "bindings": [
                  {
                    "source": "singleMode",
                    "target": "visible"
                  }
                ],
                "actions": [
                  {
                    "event": "click",
                    "action": "app.restartSinglePlayer"
                  }
                ],
                "textKey": "ui.pause.restart"
              },
              {
                "id": "pause-main",
                "type": "button",
                "class": "ui-action",
                "appearance": {
                  "tone": "neutral",
                  "emphasis": "standard",
                  "density": "comfortable",
                  "shape": "plate"
                },
                "props": {
                  "dataAct": "main"
                },
                "text": "RETURN TO MAIN MENU",
                "actions": [
                  {
                    "event": "click",
                    "action": "app.returnToMenu"
                  }
                ],
                "textKey": "ui.pause.mainMenu"
              }
            ]
          },
          {
            "id": "pause-foot",
            "type": "text",
            "class": "pause-foot",
            "text": "SELECT RESUME // RESTORE FIELD CONTROL",
            "textKey": "ui.pause.footer"
          }
        ]
      }
    ]
  },
  "previewStates": [
    {
      "id": "singlePlayer",
      "label": "Single Player",
      "context": {
        "singleMode": true
      }
    },
    {
      "id": "multiplayer",
      "label": "Multiplayer",
      "context": {
        "singleMode": false
      }
    }
  ]
}
