            { "id": "boot-sub", "type": "text", "class": "logo-sub", "text": "ONE TANK · TWO BRAINS · ZERO BRAKES" }
          ] },
          { "id": "boot-hint", "type": "text", "class": "boot-hint", "text": "CLICK TO ENTER" },
          { "id": "boot-keys", "type": "text", "class": "boot-keys", "text": "WASD DRIVE · MOUSE AIM · RIGHT-CLICK CANNON" }
