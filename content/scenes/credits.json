{
  "id": "scene.credits",
  "label": "Credits & Asset Licenses",
  "type": "ui",
  "enterTransition": {
    "type": "fade",
    "durationMs": 460
  },
  "exitTransition": {
    "type": "fade",
    "durationMs": 380
  },
  "root": {
    "id": "screen-credits",
    "type": "container",
    "class": "screen ui-overlay-screen credits-overlay",
    "children": [
      {
        "id": "credits-scrim",
        "type": "container",
        "class": "ui-overlay-scrim"
      },
      {
        "id": "credits-panel",
        "type": "panel",
        "class": "ui-overlay-panel ui-credits-panel",
        "appearance": {
          "tone": "neutral",
          "emphasis": "hero",
          "density": "comfortable",
          "shape": "plate"
        },
        "children": [
          {
            "id": "credits-kicker",
            "type": "text",
            "class": "ui-kicker",
            "text": "RECOIL CREW // ATTRIBUTION RECORD",
            "textKey": "ui.credits.kicker"
          },
          {
            "id": "credits-title",
            "type": "text",
            "props": {
              "tag": "h2"
            },
            "text": "CREDITS & ASSET LICENSES",
            "textKey": "ui.credits.title"
          },
          {
            "id": "credits-rule",
            "type": "container",
            "class": "ui-overlay-rule"
          },
          {
            "id": "credits-body",
            "type": "container",
            "class": "ui-credits-body",
            "children": [
              {
                "id": "credits-development",
                "type": "container",
                "class": "ui-credits-section ui-credits-section--wide",
                "children": [
                  {
                    "id": "credits-development-heading",
                    "type": "text",
                    "props": {
                      "tag": "h3"
                    },
                    "text": "GAME DESIGN & DEVELOPMENT",
                    "textKey": "ui.credits.developmentHeading"
                  },
                  {
                    "id": "credits-development-name",
                    "type": "text",
                    "class": "ui-credits-name",
                    "props": {
                      "tag": "p"
                    },
                    "text": "MinWoo Lim",
                    "textKey": "ui.credits.developer"
                  }
                ]
              },
              {
                "id": "credits-assets",
                "type": "container",
                "class": "ui-credits-section ui-credits-section--wide",
                "children": [
                  {
                    "id": "credits-assets-heading",
                    "type": "text",
                    "props": {
                      "tag": "h3"
                    },
                    "text": "3D ASSETS",
                    "textKey": "ui.credits.assetsHeading"
                  },
                  {
                    "id": "credits-assets-intro",
                    "type": "text",
                    "class": "ui-credits-copy",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Selected models from the following asset packs by Quaternius:",
                    "textKey": "ui.credits.assetsIntro"
                  },
                  {
                    "id": "credits-assets-list",
                    "type": "text",
                    "class": "ui-credits-asset-list",
                    "props": {
                      "tag": "p"
                    },
                    "text": "• Ultimate Monsters\n• Zombie Apocalypse Kit\n• Ultimate Buildings Pack\n• Ultimate Nature Pack\n• Animated Tanks Pack\n• Ultimate RPG Pack",
                    "textKey": "ui.credits.assetPacks"
                  },
                  {
                    "id": "credits-assets-license",
                    "type": "text",
                    "class": "ui-credits-license",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Used under Creative Commons CC0 1.0.",
                    "textKey": "ui.credits.assetsLicense"
                  },
                  {
                    "id": "credits-assets-note",
                    "type": "text",
                    "class": "ui-credits-copy",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Selected models were adapted and integrated for Recoil Crew.",
                    "textKey": "ui.credits.assetsAdapted"
                  }
                ]
              },
              {
                "id": "credits-music",
                "type": "container",
                "class": "ui-credits-section",
                "children": [
                  {
                    "id": "credits-music-heading",
                    "type": "text",
                    "props": {
                      "tag": "h3"
                    },
                    "text": "MUSIC",
                    "textKey": "ui.credits.musicHeading"
                  },
                  {
                    "id": "credits-music-tracks",
                    "type": "text",
                    "class": "ui-credits-highlight",
                    "props": {
                      "tag": "p"
                    },
                    "text": "“Recoil Crew BGM 1” and “Recoil Crew BGM 2”",
                    "textKey": "ui.credits.musicTracks"
                  },
                  {
                    "id": "credits-music-origin",
                    "type": "text",
                    "class": "ui-credits-copy",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Generated by MinWoo Lim using Suno Pro while subscribed to a paid plan.",
                    "textKey": "ui.credits.musicOrigin"
                  },
                  {
                    "id": "credits-music-rights",
                    "type": "text",
                    "class": "ui-credits-license",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Used under Suno’s granted commercial-use rights.",
                    "textKey": "ui.credits.musicRights"
                  }
                ]
              },
              {
                "id": "credits-sfx",
                "type": "container",
                "class": "ui-credits-section",
                "children": [
                  {
                    "id": "credits-sfx-heading",
                    "type": "text",
                    "props": {
                      "tag": "h3"
                    },
                    "text": "SOUND EFFECTS",
                    "textKey": "ui.credits.sfxHeading"
                  },
                  {
                    "id": "credits-sfx-runtime",
                    "type": "text",
                    "class": "ui-credits-copy",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Combat sound effects are synthesized at runtime using the Web Audio API.",
                    "textKey": "ui.credits.sfxRuntime"
                  },
                  {
                    "id": "credits-sfx-assets",
                    "type": "text",
                    "class": "ui-credits-license",
                    "props": {
                      "tag": "p"
                    },
                    "text": "No external pre-recorded SFX assets are included.",
                    "textKey": "ui.credits.sfxAssets"
                  }
                ]
              },
              {
                "id": "credits-legal",
                "type": "container",
                "class": "ui-credits-legal ui-credits-section--wide",
                "children": [
                  {
                    "id": "credits-copyright",
                    "type": "text",
                    "class": "ui-credits-copyright",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Recoil Crew © 2026 MinWoo Lim",
                    "textKey": "ui.credits.copyright"
                  },
                  {
                    "id": "credits-exception",
                    "type": "text",
                    "class": "ui-credits-copy",
                    "props": {
                      "tag": "p"
                    },
                    "text": "Except for the third-party materials listed above.",
                    "textKey": "ui.credits.exception"
                  }
                ]
              }
            ]
          },
          {
            "id": "credits-back",
            "type": "button",
            "class": "ui-action ui-overlay-close",
            "appearance": {
              "tone": "action",
              "emphasis": "standard",
              "density": "comfortable",
              "shape": "plate"
            },
            "props": {
              "dataAct": "back"
            },
            "text": "BACK TO MENU",
            "actions": [
              {
                "event": "click",
                "action": "app.back"
              }
            ],
            "textKey": "ui.credits.back"
          }
        ]
      }
    ]
  },
  "previewStates": [
    {
      "id": "credits",
      "label": "Credits",
      "context": {}
    }
  ]
}
