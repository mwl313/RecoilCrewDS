{
  "id": "scene.error",
  "label": "Error",
  "type": "ui",
  "enterTransition": {
    "type": "fade",
    "durationMs": 120
  },
  "root": {
    "id": "screen-error",
    "type": "container",
    "class": "screen",
    "children": [
      {
        "id": "error-panel",
        "type": "panel",
        "class": "panel",
        "children": [
          {
            "id": "error-title",
            "type": "text",
            "props": {
              "tag": "h2"
            },
            "text": "CONNECTION LOST",
            "textKey": "ui.error.title"
          },
          {
            "id": "error-msg",
            "type": "text",
            "class": "error",
            "text": "Something went wrong.",
            "bindings": [
              {
                "target": "text",
                "source": "message",
                "fallback": "Something went wrong."
              }
            ],
            "textKey": "error.unknown"
          },
          {
            "id": "retry-btn",
            "type": "button",
            "class": "btn primary",
            "text": "RETRY",
            "actions": [
              {
                "event": "click",
                "action": "app.retry"
              }
            ],
            "textKey": "ui.error.retry"
          },
          {
            "id": "error-single",
            "type": "button",
            "class": "btn",
            "props": {
              "dataAct": "single"
            },
            "text": "SINGLE PLAYER",
            "actions": [
              {
                "event": "click",
                "action": "app.startSinglePlayer"
              }
            ],
            "textKey": "ui.error.singlePlayer"
          },
          {
            "id": "error-main",
            "type": "button",
            "class": "btn ghost",
            "props": {
              "dataAct": "main"
            },
            "text": "MAIN MENU",
            "actions": [
              {
                "event": "click",
                "action": "app.returnToMenu"
              }
            ],
            "textKey": "ui.error.mainMenu"
          }
        ]
      }
    ]
  },
  "previewStates": [
    {
      "id": "lost",
      "label": "Connection lost",
      "context": {
        "message": "Connection lost. The server may have restarted."
      }
    }
  ]
}
