{
  "id": "hud.gameplay",
  "label": "Gameplay HUD",
  "role": "shared",
  "themeId": "theme.base",
  "root": {
    "id": "hud",
    "type": "container",
    "class": "hud hidden",
    "children": [
      {
        "id": "hud-top",
        "type": "horizontal",
        "class": "hud-top",
        "children": [
          {
            "id": "hud-left",
            "type": "horizontal",
            "class": "hud-left",
            "children": [
              { "id": "role-chip", "type": "roleChip", "text": "DRIVER", "bindings": [
                { "target": "text", "source": "role", "transform": "roleLabel" },
                { "target": "visible", "source": "session.showRoleIdentity" }
              ] },
              { "id": "conn-dot", "type": "connectionIndicator", "bindings": [
                { "target": "class", "source": "connection.peerConnected", "transform": "booleanClass", "attribute": "off", "fallback": true },
                { "target": "visible", "source": "session.showPeerStatus" }
              ] },
              { "id": "ping", "type": "statText", "class": "ping", "text": "--ms", "bindings": [
                { "target": "text", "source": "connection.pingMs", "format": "{0}ms", "fallback": "--ms" },
                { "target": "visible", "source": "session.showPeerStatus" }
              ] }
            ]
          },
          {
            "id": "hud-timer",
            "type": "container",
            "class": "hud-timer",
            "children": [
              { "id": "timer", "type": "statText", "text": "90", "bindings": [
                { "target": "text", "source": "match.timeRemaining", "transform": "integer" },
                { "target": "class", "source": "match.timeUrgent", "transform": "booleanClass", "attribute": "urgent" }
              ] }
            ]
          },
          {
            "id": "hud-right",
            "type": "horizontal",
            "class": "hud-right",
            "children": [
              { "id": "score", "type": "statText", "class": "score", "text": "0", "bindings": [{ "target": "text", "source": "match.scoreText" }] },
              { "id": "combo", "type": "statText", "class": "combo", "text": "×1", "bindings": [
                { "target": "text", "source": "match.combo", "format": "×{0}" },
                { "target": "class", "source": "match.comboHot", "transform": "booleanClass", "attribute": "hot" }
              ] }
            ]
          }
        ]
      },
      {
        "id": "hud-stage",
        "type": "vertical",
        "class": "hud-stage",
        "children": [
          {
            "id": "stage-wave-label",
            "type": "text",
            "class": "stage-wave-label",
            "text": "",
            "bindings": [
              { "target": "text", "source": "stage.waveLabel" },
              { "target": "class", "source": "stage.waveActive", "transform": "booleanClass", "attribute": "wave" }
            ]
          },
          {
            "id": "stage-timer",
            "type": "statText",
            "class": "stage-timer",
            "text": "",
            "bindings": [{ "target": "text", "source": "stage.farmingLabel" }]
          },
          {
            "id": "stage-leader-hp",
            "type": "progressBar",
            "class": "stage-leader-hp",
            "props": { "valueSource": "stage.leaderHpRatio", "maxSource": "stage.leaderHpMax" },
            "bindings": [{ "target": "visible", "source": "stage.waveActive" }]
          }
        ]
      },
      {
        "id": "hud-bottom",
        "type": "horizontal",
        "class": "hud-bottom",
        "children": [
          {
            "id": "hud-bars",
            "type": "vertical",
            "class": "hud-bars",
            "children": [
              {
                "id": "integrity-row",
                "type": "horizontal",
                "class": "bar-row",
                "children": [
                  { "id": "integrity-label", "type": "text", "class": "bar-label", "text": "INTEGRITY" },
                  { "id": "integrity-wrap", "type": "container", "class": "bar", "children": [
                    { "id": "integrity", "type": "progressBar", "class": "bar-fill integrity", "props": { "valueSource": "tank.integrity", "maxSource": "tank.integrityMax" }, "bindings": [{ "target": "class", "source": "tank.integrityLow", "transform": "booleanClass", "attribute": "low" }] }
                  ] }
                ]
              }
            ]
          },
          {
            "id": "hud-speed",
            "type": "vertical",
            "class": "hud-speed",
            "children": [
              {
                "id": "speed-num",
                "type": "horizontal",
                "class": "speed-num",
                "children": [
                  { "id": "speed", "type": "statText", "text": "0", "bindings": [{ "target": "text", "source": "tank.speed", "transform": "integer" }] },
                  { "id": "speed-unit", "type": "text", "props": { "tag": "small" }, "text": "KM/H" }
                ]
              },
              { "id": "dash-ind", "type": "text", "class": "dash-ind", "text": "DASH", "bindings": [
                { "target": "class", "source": "tank.dashActive", "transform": "booleanClass", "attribute": "on" },
                { "target": "class", "source": "tank.dashCooling", "transform": "booleanClass", "attribute": "cool" }
              ] }
            ]
          }
        ]
      },
      {
        "id": "hud-center",
        "type": "container",
        "class": "hud-center",
        "children": [
          {
            "id": "crosshair",
            "type": "crosshair",
            "class": "crosshair hidden",
            "bindings": [{ "target": "visible", "source": "crosshairVisible" }],
            "children": [
              { "id": "ch-dot", "type": "container", "class": "ch-dot" },
              { "id": "ch-ring", "type": "arcMeter", "class": "ch-ring", "props": { "valueSource": "gunner.cooldownRatio" } },
              {
                "id": "crosshair-charge",
                "type": "container",
                "class": "crosshair-charge",
                "bindings": [{ "target": "visible", "source": "gunner.chargeUnlocked" }],
                "children": [
                  {
                    "id": "crosshair-charge-fill",
                    "type": "progressBar",
                    "class": "crosshair-charge-fill",
                    "props": { "valueSource": "gunner.chargeRatio", "maxSource": "gunner.chargeMax", "direction": "vertical" },
                    "bindings": [
                      { "target": "class", "source": "gunner.chargeHeld", "transform": "booleanClass", "attribute": "held" },
                      { "target": "class", "source": "gunner.chargeFull", "transform": "booleanClass", "attribute": "full" }
                    ]
                  }
                ]
              }
            ]
          },
          { "id": "prompt", "type": "text", "class": "prompt", "bindings": [{ "target": "text", "source": "prompt" }] },
          { "id": "prompt-sub", "type": "text", "class": "prompt-sub", "bindings": [{ "target": "text", "source": "promptSub" }] }
        ]
      },
      {
        "id": "objective-arrow",
        "type": "text",
        "class": "objective hidden",
        "text": "▼",
        "bindings": [
          { "target": "visible", "source": "objective.visible" },
          { "target": "style", "source": "objective.screenX", "attribute": "left", "format": "{0}px" },
          { "target": "style", "source": "objective.screenY", "attribute": "top", "format": "{0}px" }
        ]
      },
      { "id": "fps", "type": "statText", "class": "fps", "text": "", "bindings": [{ "target": "text", "source": "connection.fps", "format": "{0} FPS", "fallback": "" }] },
      { "id": "popups", "type": "popupLayer", "class": "popups" },
      { "id": "pause-btn", "type": "pauseButton", "class": "pause-btn", "text": "☰", "props": { "title": "menu" }, "actions": [{ "event": "click", "action": "app.pause" }] }
    ]
  },
  "previewStates": [
    {
      "id": "driver",
      "label": "Driver",
      "context": {
        "role": "driver",
        "session": { "kind": "multiplayer", "showRoleIdentity": true, "showPeerStatus": true },
        "connection": { "peerConnected": true, "pingMs": 24, "fps": 60 },
        "match": { "timeRemaining": 72, "timeUrgent": false, "score": 3200, "scoreText": "3,200", "combo": 3, "comboHot": true },
        "tank": { "integrity": 84, "integrityMax": 100, "integrityLow": false, "speed": 42, "grounded": true, "dashReady": true, "dashActive": false, "dashCooling": false },
        "gunner": { "cannonCooldown": 0, "cooldownRatio": 0, "chargeUnlocked": false, "chargeHeld": false, "chargeRatio": 0, "chargeFull": false },
        "prompt": "DRIVE · COLLECT SCRAP",
        "promptSub": "WASD + SHIFT + SPACE",
        "crosshairVisible": false,
        "pointerLocked": true,
        "objective": { "visible": false, "screenX": 0, "screenY": 0, "label": "" },
        "stage": { "phase": "farming1", "farmingTimeRemaining": 72, "waveId": null, "leaderHp": 0, "leaderMaxHp": 0 }
      }
    },
    {
      "id": "gunner",
      "label": "Gunner",
      "context": {
        "role": "gunner",
        "session": { "kind": "multiplayer", "showRoleIdentity": true, "showPeerStatus": true },
        "connection": { "peerConnected": true, "pingMs": 31, "fps": 58 },
        "match": { "timeRemaining": 5, "timeUrgent": true, "score": 5210, "scoreText": "5,210", "combo": 5, "comboHot": true },
        "tank": { "integrity": 22, "integrityMax": 100, "integrityLow": true, "speed": 0, "grounded": true, "dashReady": false, "dashActive": false, "dashCooling": true },
        "gunner": { "cannonCooldown": 1.0, "cooldownRatio": 0.625, "chargeUnlocked": true, "chargeHeld": true, "chargeRatio": 0.5, "chargeFull": false },
        "prompt": "HOLD TO CHARGE",
        "promptSub": "HOLD RIGHT MOUSE TO CHARGE",
        "crosshairVisible": true,
        "pointerLocked": true,
        "objective": { "visible": true, "screenX": 420, "screenY": 180, "label": "LOOT TRUCK" },
        "stage": { "phase": "wave1", "farmingTimeRemaining": 120, "waveId": 1, "leaderHp": 40, "leaderMaxHp": 100 }
      }
    },
    {
      "id": "singlePlayer",
      "label": "Single Player",
      "context": {
        "role": "driver",
        "session": { "kind": "singlePlayer", "showRoleIdentity": false, "showPeerStatus": false },
        "connection": { "peerConnected": false, "pingMs": 0, "fps": 60 },
        "match": { "timeRemaining": 61, "timeUrgent": false, "score": 1940, "scoreText": "1,940", "combo": 2, "comboHot": false },
        "tank": { "integrity": 71, "integrityMax": 100, "integrityLow": false, "speed": 33, "grounded": true, "dashReady": true, "dashActive": false, "dashCooling": false },
        "gunner": { "cannonCooldown": 0, "cooldownRatio": 0, "chargeUnlocked": true, "chargeHeld": false, "chargeRatio": 0, "chargeFull": false },
        "prompt": "DRIVE · AIM · FIRE",
        "promptSub": "WASD · SHIFT · SPACE · LMB · RMB",
        "crosshairVisible": true,
        "pointerLocked": true,
        "objective": { "visible": false, "screenX": 0, "screenY": 0, "label": "" },
        "stage": { "phase": "farming1", "farmingTimeRemaining": 61, "waveId": null, "leaderHp": 0, "leaderMaxHp": 0 }
      }
    }
  ]
}
