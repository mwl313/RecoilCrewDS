# Port the authoritative game server listens on (client build is served from the
# same HTTP server in production).
PORT=8080

# Interface to bind. Production behind Caddy should use 127.0.0.1.
HOST=0.0.0.0

# Comma-separated list of origins allowed to open WebSocket connections.
# Use * for public deployments behind a CDN or when the client is same-origin.
ALLOWED_ORIGINS=*

# Optional test utility: multiply the simulation time step. Leave at 1.
RECOIL_TIME_SCALE=1

# Optional: set to a custom static client directory (defaults to ./dist).
STATIC_DIR=dist

# Optional release identifier returned by GET /healthz.
RELEASE_SHA=dev

# Client build options (defaults shown). A Pages build uses
# VITE_BASE_PATH=/RecoilCrewDS/ and an absolute wss: VITE_GAME_SERVER_URL.
VITE_BASE_PATH=/
VITE_GAME_SERVER_URL=
